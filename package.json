{
  "name": "wikipedia-trends-skill",
  "version": "1.0.0",
  "description": "Agent Skill: analyze Wikipedia pageviews across languages and generate a 1-page PDF market-research report.",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test:agent": "ts-node src/testAnthropicAgent.ts",
    "test:openrouter": "ts-node src/testOpenRouterAgent.ts",
    "test": "node --require ts-node/register --test src/**/*.test.ts",
    "clean": "rm -rf dist"
  },
  "license": "MIT",
  "overrides": {
    "canvas": "^3.2.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "axios": "^1.7.9",
    "chart.js": "^3.9.1",
    "chartjs-node-canvas": "^4.1.6",
    "date-fns": "^4.1.0",
    "marked": "^4.3.0",
    "marked-terminal": "^5.2.0",
    "ora": "^5.4.1",
    "pdfkit": "^0.15.1",
    "picocolors": "^1.1.1",
    "uuid": "^11.0.4",
    "zod": "3.23.8",
    "zod-to-json-schema": "3.23.5"
  },
  "devDependencies": {
    "@types/marked": "^4.3.2",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.13.9",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
